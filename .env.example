# Copy to .env and fill in what you need. Everything except GITHUB_TOKEN is optional.

# GitHub personal access token (no scopes needed) - raises the search rate limit.
GITHUB_TOKEN=

# AI summary via Ollama (free, open models). Skipped automatically if Ollama isn't running.
# Local setup: `ollama serve` then `ollama pull qwen2.5:3b`
# OLLAMA_HOST=http://localhost:11434
# AI_MODEL=qwen2.5:3b

# Email delivery (Gmail needs an App Password). Leave empty to skip email.
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Pipeline settings
# TOPIC=machine learning
# TOP_N=200
# RISING_DAYS=30

# Storage - defaults to CSV snapshots in data/history/. Set DATABASE_URL to use a database instead.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/github_trends
